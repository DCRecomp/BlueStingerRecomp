{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": { "VSLANG": "1033" }
    },
    { "name": "msvc-debug",    "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug",   "CMAKE_C_COMPILER": "cl",       "CMAKE_CXX_COMPILER": "cl", "BS_MSVC_DEPS_JSON": "ON", "BS_VALIDACAO": "ON" } },
    { "name": "msvc-release",  "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_C_COMPILER": "cl",       "CMAKE_CXX_COMPILER": "cl", "BS_MSVC_DEPS_JSON": "ON" } },
    { "name": "msvc-validacao", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_C_COMPILER": "cl",      "CMAKE_CXX_COMPILER": "cl", "BS_MSVC_DEPS_JSON": "ON", "BS_VALIDACAO": "ON", "BS_BUILD_GAME": "ON" } },
    { "name": "msvc-release-mods", "inherits": "msvc-validacao", "cacheVariables": { "BS_MODS": "ON", "BS_WRITE_WATCH": "OFF" } },
    { "name": "msvc-release-watch", "inherits": "msvc-validacao", "cacheVariables": { "BS_MODS": "ON", "BS_WRITE_WATCH": "ON" } },
    { "name": "clang-debug",   "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug",   "CMAKE_C_COMPILER": "clang-cl", "CMAKE_CXX_COMPILER": "clang-cl", "BS_VALIDACAO": "ON" } },
    { "name": "clang-release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_C_COMPILER": "clang-cl", "CMAKE_CXX_COMPILER": "clang-cl" } },
    { "name": "linux-base", "hidden": true, "inherits": "base", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld" } },
    { "name": "linux-debug",    "inherits": "linux-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BS_VALIDACAO": "ON" } },
    { "name": "linux-release",  "inherits": "linux-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BS_BUILD_GAME": "ON" } },
    { "name": "linux-validacao", "inherits": "linux-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BS_VALIDACAO": "ON", "BS_BUILD_GAME": "ON" } }
  ],
  "buildPresets": [
    { "name": "msvc-debug",    "configurePreset": "msvc-debug" },
    { "name": "msvc-release",  "configurePreset": "msvc-release" },
    { "name": "msvc-validacao", "configurePreset": "msvc-validacao" },
    { "name": "msvc-release-mods", "configurePreset": "msvc-release-mods" },
    { "name": "msvc-release-watch", "configurePreset": "msvc-release-watch" },
    { "name": "clang-debug",   "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "linux-debug",   "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-validacao", "configurePreset": "linux-validacao" }
  ],
  "testPresets": [
    { "name": "msvc-debug",  "configurePreset": "msvc-debug",  "output": { "outputOnFailure": true }, "execution": { "timeout": 900 } },
    { "name": "clang-debug", "configurePreset": "clang-debug", "output": { "outputOnFailure": true }, "execution": { "timeout": 900 } },
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true }, "execution": { "timeout": 900 } }
  ]
}
