{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Blue Stinger Recompiled",
  "repo": "DCRecomp/BlueStingerRecomp",
  "inputs": [
    {
      "id": "game",
      "label": "Your Blue Stinger disc (.gdi, .cue, .chd or .cdi, also inside .zip or .7z): USA, Europe PAL or Japan",
      "role": "game",
      "dumps": [
        { "name": "USA (CHD)", "size": 682239421, "crc32": "52979bf6" },
        { "name": "Europe (CHD)", "size": 749517743, "crc32": "637933fe" },
        { "name": "France (CHD)", "size": 744491774, "crc32": "d87fabbd" },
        { "name": "Japan (CHD)", "size": 736456917, "crc32": "139f5372" },
        { "name": "USA DCCM (CDI)", "size": 811293765, "crc32": "80c098f8" }
      ],
      "formats": [
        {
          "type": "file",
          "extensions": [
            "gdi",
            "cue",
            "chd",
            "cdi",
            "zip",
            "7z"
          ]
        }
      ]
    }
  ],
  "prepare": {
    "program": [
      "bs-builder.exe"
    ],
    "args": [
      "--disc",
      "{input:game}",
      "--out",
      "{install}/jogo",
      "--saves-portatil",
      "--progresso-launcher"
    ],
    "label": "Building the native game from your disc",
    "done": [
      "{install}/jogo/BlueStinger/BlueStinger.exe"
    ],
    "options": [
      {
        "id": "portable_compiler",
        "label": "Use the portable compiler",
        "note": "Downloads the official Zig, CMake and Ninja (about 125 MB). Untick it if Visual Studio 2022 or its Build Tools are installed.",
        "args": [
          "--compilador-portatil"
        ],
        "os": [
          "windows"
        ],
        "default": true
      },
      {
        "id": "remastered",
        "label": "Remastered edition",
        "note": "Widescreen, free camera and modern menus. USA disc only: untick it for the PAL and Japanese discs, which install the Original edition.",
        "args": [
          "--edicao",
          "remastered"
        ],
        "default": true
      },
      {
        "id": "widescreen_movies",
        "label": "Widescreen movies (Remastered)",
        "note": "Downloads the 16:9 movies mod (16 movies) from archive.org. Remastered edition only.",
        "args": [
          "--filmes-widescreen"
        ],
        "default": true
      }
    ]
  },
  "start": {
    "program": [
      "jogo/BlueStinger/BlueStinger.exe"
    ]
  },
  "saves": [
    "{install}/jogo/BlueStinger/saves",
    "{install}/jogo/BlueStinger/controles.toml",
    "{install}/jogo/BlueStinger/legendas.toml",
    "{install}/jogo/BlueStinger/audio.toml"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/jogo/BlueStinger/saves"
      }
    ],
    "logs": [
      {
        "path": "{install}/jogo/.bs-build"
      }
    ],
    "game": [
      {
        "path": "{install}/jogo/BlueStinger"
      }
    ],
    "mods": [
      {
        "path": "{install}/jogo/BlueStinger/mods"
      }
    ]
  },
  "actions": [
    {
      "id": "open_saves",
      "label": "Open the saves folder",
      "open": "saves"
    },
    {
      "id": "open_mods",
      "label": "Open the mods folder",
      "help": "Subtitles, widescreen movies and HD textures live here.",
      "open": "mods"
    },
    {
      "id": "open_logs",
      "label": "Open the setup log",
      "open": "logs"
    }
  ],
  "exit_codes": {
    "0": "ok"
  },
  "config": [
    {
      "id": "main",
      "format": "toml",
      "file": [
        {
          "path": "{install}/jogo/BlueStinger/graficos.toml"
        }
      ]
    },
    {
      "id": "subs",
      "format": "toml",
      "file": [
        {
          "path": "{install}/jogo/BlueStinger/legendas.toml"
        }
      ]
    },
    {
      "id": "audio",
      "format": "toml",
      "file": [
        {
          "path": "{install}/jogo/BlueStinger/audio.toml"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "window",
      "label": "Display mode",
      "group": "Video",
      "choices": [
        {
          "label": "Fullscreen",
          "set": {
            "tela/modo": "\"tela_cheia\""
          }
        },
        {
          "label": "Borderless",
          "set": {
            "tela/modo": "\"sem_bordas\""
          }
        },
        {
          "label": "Window",
          "set": {
            "tela/modo": "\"janela\""
          }
        }
      ],
      "defaults": {
        "tela/modo": "\"janela\""
      }
    },
    {
      "id": "resolution",
      "label": "Internal resolution",
      "group": "Video",
      "help": "Higher looks sharper and needs a stronger GPU. The game lowers it if the GPU can't.",
      "choices": [
        {
          "label": "Original (480p)",
          "set": {
            "imagem/resolucao": "\"original\""
          }
        },
        {
          "label": "720p",
          "set": {
            "imagem/resolucao": "\"720p\""
          }
        },
        {
          "label": "1080p",
          "set": {
            "imagem/resolucao": "\"1080p\""
          }
        },
        {
          "label": "1440p",
          "set": {
            "imagem/resolucao": "\"1440p\""
          }
        },
        {
          "label": "4K (2160p)",
          "set": {
            "imagem/resolucao": "\"2160p\""
          }
        }
      ],
      "defaults": {
        "imagem/resolucao": "\"original\""
      }
    },
    {
      "id": "aspect",
      "label": "Aspect ratio (Remastered)",
      "group": "Video",
      "choices": [
        {
          "label": "16:9 widescreen",
          "set": {
            "tela/proporcao": "\"16:9\""
          }
        },
        {
          "label": "4:3 original",
          "set": {
            "tela/proporcao": "\"4:3\""
          }
        }
      ],
      "defaults": {
        "tela/proporcao": "\"4:3\""
      }
    },
    {
      "id": "vsync",
      "label": "VSync",
      "group": "Video",
      "choices": [
        {
          "label": "On",
          "set": {
            "tela/vsync": "true"
          }
        },
        {
          "label": "Off",
          "set": {
            "tela/vsync": "false"
          }
        }
      ],
      "defaults": {
        "tela/vsync": "true"
      }
    },
    {
      "id": "antialiasing",
      "label": "Antialiasing (Remastered)",
      "group": "Video",
      "choices": [
        {
          "label": "Off",
          "set": {
            "imagem/antialiasing": "\"original\""
          }
        },
        {
          "label": "Area",
          "set": {
            "imagem/antialiasing": "\"area\""
          }
        },
        {
          "label": "Edges",
          "set": {
            "imagem/antialiasing": "\"bordas\""
          }
        }
      ],
      "defaults": {
        "imagem/antialiasing": "\"original\""
      }
    },
    {
      "id": "filtering",
      "label": "Texture filtering",
      "group": "Video",
      "choices": [
        {
          "label": "Original",
          "set": {
            "imagem/filtragem": "\"original\""
          }
        },
        {
          "label": "Bilinear",
          "set": {
            "imagem/filtragem": "\"bilinear\""
          }
        },
        {
          "label": "Anisotropic",
          "set": {
            "imagem/filtragem": "\"anisotropica\""
          }
        }
      ],
      "defaults": {
        "imagem/filtragem": "\"original\""
      }
    },
    {
      "id": "hd_textures",
      "label": "HD textures (Remastered)",
      "group": "Video",
      "help": "Uses HD texture packs from the mods folder when they exist.",
      "choices": [
        {
          "label": "On",
          "set": {
            "imagem/texturas_hd": "true"
          }
        },
        {
          "label": "Off",
          "set": {
            "imagem/texturas_hd": "false"
          }
        }
      ],
      "defaults": {
        "imagem/texturas_hd": "false"
      }
    },
    {
      "id": "lighting",
      "label": "Enhanced lighting (Remastered)",
      "group": "Remastered effects",
      "advanced": true,
      "choices": [
        {
          "label": "On",
          "set": {
            "imagem/iluminacao": "true"
          }
        },
        {
          "label": "Off",
          "set": {
            "imagem/iluminacao": "false"
          }
        }
      ],
      "defaults": {
        "imagem/iluminacao": "false"
      }
    },
    {
      "id": "shadows",
      "label": "Shadows (Remastered)",
      "group": "Remastered effects",
      "advanced": true,
      "choices": [
        {
          "label": "Original",
          "set": {
            "imagem/sombras": "\"original\""
          }
        },
        {
          "label": "Enhanced",
          "set": {
            "imagem/sombras": "\"aprimoradas\""
          }
        }
      ],
      "defaults": {
        "imagem/sombras": "\"original\""
      }
    },
    {
      "id": "water",
      "label": "Water (Remastered)",
      "group": "Remastered effects",
      "advanced": true,
      "choices": [
        {
          "label": "Original",
          "set": {
            "imagem/agua": "\"original\""
          }
        },
        {
          "label": "Enhanced",
          "set": {
            "imagem/agua": "\"aprimorada\""
          }
        },
        {
          "label": "High",
          "set": {
            "imagem/agua": "\"alta\""
          }
        }
      ],
      "defaults": {
        "imagem/agua": "\"original\""
      }
    },
    {
      "id": "ssao",
      "label": "Ambient occlusion (Remastered)",
      "group": "Remastered effects",
      "advanced": true,
      "choices": [
        {
          "label": "Off",
          "set": {
            "efeitos/ssao": "false"
          }
        },
        {
          "label": "Low",
          "set": {
            "efeitos/ssao": "true",
            "efeitos/ssao_qualidade": "\"baixa\""
          }
        },
        {
          "label": "Medium",
          "set": {
            "efeitos/ssao": "true",
            "efeitos/ssao_qualidade": "\"media\""
          }
        },
        {
          "label": "High",
          "set": {
            "efeitos/ssao": "true",
            "efeitos/ssao_qualidade": "\"alta\""
          }
        }
      ],
      "defaults": {
        "efeitos/ssao": "false",
        "efeitos/ssao_qualidade": "\"media\""
      }
    },
    {
      "id": "subtitles",
      "label": "Subtitles",
      "group": "Subtitles",
      "in": "subs",
      "choices": [
        {
          "label": "On",
          "set": {
            "ligadas": "true"
          }
        },
        {
          "label": "Off",
          "set": {
            "ligadas": "false"
          }
        }
      ],
      "defaults": {
        "ligadas": "true"
      }
    },
    {
      "id": "subtitle_language",
      "label": "Subtitle language",
      "group": "Subtitles",
      "in": "subs",
      "choices": [
        {
          "label": "Automatic (Windows language)",
          "set": {
            "idioma": "\"auto\""
          }
        },
        {
          "label": "English",
          "set": {
            "idioma": "\"en-US\""
          }
        },
        {
          "label": "Português (Brasil)",
          "set": {
            "idioma": "\"pt-BR\""
          }
        },
        {
          "label": "Español",
          "set": {
            "idioma": "\"es-ES\""
          }
        },
        {
          "label": "Français",
          "set": {
            "idioma": "\"fr-FR\""
          }
        },
        {
          "label": "Русский",
          "set": {
            "idioma": "\"ru-RU\""
          }
        },
        {
          "label": "日本語",
          "set": {
            "idioma": "\"ja-JP\""
          }
        },
        {
          "label": "中文（简体）",
          "set": {
            "idioma": "\"zh-CN\""
          }
        }
      ],
      "defaults": {
        "idioma": "\"auto\""
      },
      "help": "Automatic uses the Windows language when its subtitles are installed; otherwise Portuguese (Brazil), then English."
    },
    {
      "id": "subtitle_size",
      "label": "Subtitle size (%)",
      "group": "Subtitles",
      "in": "subs",
      "slider": {
        "key": "tamanho",
        "min": 50,
        "max": 200,
        "step": 10,
        "format": "%g"
      },
      "defaults": {
        "tamanho": "100"
      }
    },
    {
      "id": "volume_master",
      "label": "Master volume",
      "group": "Audio",
      "in": "audio",
      "slider": {
        "key": "geral",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%g"
      },
      "defaults": {
        "geral": "100"
      }
    },
    {
      "id": "volume_music",
      "label": "Music volume",
      "group": "Audio",
      "in": "audio",
      "slider": {
        "key": "musica",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%g"
      },
      "defaults": {
        "musica": "100"
      }
    },
    {
      "id": "volume_effects",
      "label": "Effects volume",
      "group": "Audio",
      "in": "audio",
      "slider": {
        "key": "efeitos",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%g"
      },
      "defaults": {
        "efeitos": "100"
      }
    },
    {
      "id": "volume_voices",
      "label": "Voices volume",
      "group": "Audio",
      "in": "audio",
      "slider": {
        "key": "vozes",
        "min": 0,
        "max": 100,
        "step": 5,
        "format": "%g"
      },
      "defaults": {
        "vozes": "100"
      }
    }
  ],
  "system": {
    "windows": {
      "version": "10"
    }
  }
}
