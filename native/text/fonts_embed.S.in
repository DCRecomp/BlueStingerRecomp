/* N9-L (L4): as fontes do texto (Noto Sans, OFL 1.1, third_party/fonts/noto-sans) dentro do executavel, sem arquivo a
   instalar. Gerado pelo CMake (native/CMakeLists.txt) com os caminhos absolutos das fontes. */
    .section .rodata.bs_fonts,"a",@progbits
    .balign 16
    .globl bs_font_noto_regular
    .globl bs_font_noto_regular_end
bs_font_noto_regular:
    .incbin "@BS_FONT_REGULAR@"
bs_font_noto_regular_end:
    .balign 16
    .globl bs_font_noto_semibold
    .globl bs_font_noto_semibold_end
bs_font_noto_semibold:
    .incbin "@BS_FONT_SEMIBOLD@"
bs_font_noto_semibold_end:
    .section .note.GNU-stack,"",@progbits
